[Unit]
Description=On-demand front door for dev.rootsofthevalley.org

# The proxy vhost points at 127.0.0.1:8087. Holding the port here instead of
# in the container lets the first request start the container, so it does not
# have to run while nobody is using it. The idle timer stops it again; see
# dev.rootsofthevalley.org-idle.service.
#
# Host prerequisite: systemd binds this socket in the proxy's SELinux domain,
# systemd_socket_proxyd_t, which by default may neither bind 8087 nor connect
# to 18087. Both booleans are set persistently on lotor:
#   setsebool -P systemd_socket_proxyd_bind_any=1 systemd_socket_proxyd_connect_any=1

[Socket]
ListenStream=127.0.0.1:8087

[Install]
WantedBy=sockets.target
