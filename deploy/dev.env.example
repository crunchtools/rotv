# Environment file for dev.rootsofthevalley.org (config/dev.env on the host).
# Shape only. The real file is committed to the private host repo, never here.

# You arrive signed in as the test admin. The proxy's basic auth is the gate.
NODE_ENV=test
BYPASS_AUTH=true

PGHOST=localhost
PGPORT=5432
PGDATABASE=rotv
PGUSER=postgres
PGPASSWORD=

SESSION_SECRET=
APP_SECRET=
UMAMI_ADMIN_PASSWORD=
ADMIN_EMAIL=

FRONTEND_URL=https://dev.rootsofthevalley.org
ROTV_DEV_HOST=dev.rootsofthevalley.org

# This container runs on a copy of production data and must not act on the
# world: no crawls, backups or digests on a timer, and no mail. Leave SMTP_*,
# IMAGE_SERVER_URL and the DKIM settings out entirely.
SCHEDULED_JOBS_ENABLED=false
NEWSLETTER_SEND_ENABLED=false
