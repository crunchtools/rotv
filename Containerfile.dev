# Roots of The Valley — hosted development image (dev.rootsofthevalley.org, #748)
# The production image plus units that run the backend and a Vite dev server
# from a checkout mounted at /work/rotv instead of the code baked into the
# image. Nothing in it edits the code: the agent that does runs in a container
# of its own and reaches this one through files (#779). See
# docs/DEVELOPMENT_ARCHITECTURE.md, "Hosted dev".

ARG ROTV_IMAGE=quay.io/crunchtools/rotv:latest
FROM ${ROTV_IMAGE}

LABEL maintainer="fatherlinux <scott.mccarty@crunchtools.com>"
LABEL description="Roots of The Valley - hosted development container"

# The image's units all run from /app. Point it at the checkout and they run
# the checkout's server.js and migrations unmodified. The built frontend stays
# reachable for the few backend routes that read index.html (STATIC_PATH, set
# in rotv-backend.service.d/dev.conf).
RUN mv /app /opt/rotv-image && \
    mkdir -p /work/rotv /var/lib/rotv-dev/control /var/lib/rotv-dev/logs && \
    ln -s /work/rotv/backend /app

COPY rootfs-dev/ /

# The control names are this image's interface; a wrong mapping fails the build.
COPY scripts/test-rotv-dev-kick.sh /tmp/test-rotv-dev-kick.sh

RUN chmod +x /usr/local/bin/rotv-dev-deps.sh /usr/local/bin/rotv-dev-kick.sh \
        /usr/local/bin/rotv-dev-log-mirror.sh && \
    bash /tmp/test-rotv-dev-kick.sh && rm -f /tmp/test-rotv-dev-kick.sh && \
    systemctl enable rotv-dev-deps rotv-dev-ui \
        rotv-dev-kick@ui.path rotv-dev-kick@backend.path \
        rotv-dev-kick@init.path rotv-dev-kick@deps.path \
        rotv-dev-lockfiles.path rotv-dev-migrations.path \
        rotv-dev-log@rotv-backend rotv-dev-log@rotv-dev-ui \
        rotv-dev-log@rotv-dev-deps rotv-dev-log@rotv-init

WORKDIR /work/rotv
EXPOSE 5173
