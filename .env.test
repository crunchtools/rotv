# Test Environment Configuration
# This file is used automatically by vitest.config.js

NODE_ENV=test
BYPASS_AUTH=true

# Database connection (tests use same DB as dev container). No PGPASSWORD:
# the bundled Postgres trusts local connections, and ./run.sh test sets a
# throwaway one in the container.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=rotv
