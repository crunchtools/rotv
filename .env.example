# Production seed data source (for development)
PRODUCTION_HOST=sven.dc3.crunchtools.com
PRODUCTION_PORT=22422
PRODUCTION_CONTAINER=rootsofthevalley.org

# Google OAuth (required for admin sync features)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Show the Facebook button publicly once the Meta app is Live (route works regardless)
FACEBOOK_LOGIN_LIVE=false
# Outbound mail for email sign-in; leave SMTP_HOST unset to disable it
SMTP_HOST=
SMTP_PORT=25
# Set to false only for a relay on a trusted local network
SMTP_TLS_VERIFY=true
MAIL_REPLY_TO=admin@rootsofthevalley.org
MAIL_ENVELOPE_FROM=admin@rootsofthevalley.org
DKIM_DOMAIN=rootsofthevalley.org
DKIM_SELECTOR=rotv1
# base64 of the PEM private key: base64 -w0 dkim.key
DKIM_PRIVATE_KEY_B64=

# Session secret (recommended: generate a random 32+ character string)
SESSION_SECRET=change-this-to-a-random-string

# Admin email (user with this email gets admin privileges)
ADMIN_EMAIL=scott.mccarty@gmail.com

# Newsletter sends (set to false for dev/test to avoid duplicate Buttondown emails)
NEWSLETTER_SEND_ENABLED=false

# Backend log verbosity: debug | info | warn | error (default info)
# LOG_LEVEL=info

# Test environment (set automatically by vitest.config.js)
# NODE_ENV=test
# BYPASS_AUTH=true
