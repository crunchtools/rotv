#!/bin/bash
# Constitution XII (v1.30.0): every verdict comes from python-sdlc's `sdlc push`,
# wired as the `sdlc-push` pre-push hook in .pre-commit-config.yaml. This repo
# keeps its git hooks in .githooks via core.hooksPath, where `pre-commit install`
# refuses to write, so this wrapper hands the push to it -- the same shape as
# .githooks/pre-commit beside it.
#
# What used to be here was a bespoke Gatehouse invocation. Gatehouse is one of
# the checks `sdlc push` runs now, at the version the release pins, so keeping a
# second copy here would be the two-versions problem XII exists to end.
exec pre-commit run --hook-stage pre-push
